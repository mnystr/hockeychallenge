# Copy to .env.local for local development.
# Run `npx supabase start` (or `npx supabase status` later) to get the values.
#
# From the "Authentication Keys" section of that output:
#   Publishable  ->  NEXT_PUBLIC_SUPABASE_ANON_KEY  (safe to ship to the browser)
#   Secret       ->  SUPABASE_SERVICE_ROLE_KEY      (server-only, never exposed)
#
# If you're on an older Supabase CLI that still prints "anon key" / "service_role key",
# use those values instead — they plug into the same variables.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional — absent = no emails sent, just logged).
# Get a key at https://resend.com. EMAIL_FROM defaults to Resend's
# sandbox sender which only delivers to verified addresses.
RESEND_API_KEY=
EMAIL_FROM=
# NEXT_PUBLIC_SITE_URL is used in email links. Defaults to
# http://localhost:3000 in local dev.
NEXT_PUBLIC_SITE_URL=
