# Copy to .env.local for local development.
# `supabase start` prints the values for the local stack — paste them here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key is used only by server code (never shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=
